async def message_router(update: Update, context: ContextTypes.DEFAULT_TYPE):
    """Route messages to appropriate handlers"""
    text = update.message.text
    user_id = update.effective_user.id
    
    # Initialize user data if not exists
    if user_id not in user_data:
        user_data[user_id] = {'state': States.HOME}
    
    # Main menu routing
    if text == "🏠 Home":
        await home_handler(update, context)
    elif text == "➕ Create":
        await create_handler(update, context)
    elif text == "💬 Messenger":
        await messenger_handler(update, context)
    elif text == "🔍 Search":
        await search_handler(update, context)
    elif text == "⚙️ Settings":
        await settings_handler(update, context)
    elif text == "👤 Profile":
        await profile_handler(update, context)
    elif text == "/contact":
        await handle_contact_info(update, context)
    elif text == "/wallet":
        await wallet_handler(update, context)
    else:
        # Handle sub-menu items
        await handle_submenu_selection(update, context)

